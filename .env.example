# Copy to .env for local dev. On Railway, set these as service Variables.
# All strategy/risk knobs live in config.yaml — only secrets + mode go here.

# sim -> offline simulator (no keys). paper/live -> Alpaca.
AGENT_MODE=sim

# Alpaca (required for paper/live). Use PAPER keys for paper mode.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Finnhub (optional) — enables the earnings + news filters. Free tier is fine.
FINNHUB_API_KEY=

# Web service
# Auto-run a cycle every POLL_SECONDS during US market hours.
ENABLE_SCHEDULER=false
# Protects POST /api/cycle (dashboard "Run cycle"). Recommended in production.
API_TOKEN=

# State store:
#  - If DATABASE_URL is set (Railway Postgres), the agent uses Postgres and
#    creates its tables automatically — durable and browsable in Railway.
#  - Otherwise it uses a local SQLite file (set STATE_DB to a volume path on
#    Railway to keep it, or leave default for local/sim).
# On Railway, add a Postgres db and REFERENCE its DATABASE_URL into this service.
# DATABASE_URL=

# Optional overrides
# POLL_SECONDS=300
# STATE_DB=/data/swing_agent.db   (only used when DATABASE_URL is unset)
